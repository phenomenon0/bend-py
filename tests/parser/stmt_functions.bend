# Expected wire AST independently derived from the pinned CPython oracle.
import Base
import ../../demos/python/syntax.bend as S
import ../../demos/python/lexer.bend as L
import ../../demos/python/parser.bend as P

def show(r: Result<&2, &2, S.Error, S.Module>) -> String:
  match r:
    case Fail{e}:
      S.error_text(e)
    case Done{m}:
      S.json(S.module(m))

def parse(s: String) -> Result<&2, &2, S.Error, S.Module>:
  do Result<&2, &2, S.Error, S.Module>:
    ts : List<&2, S.Tok> <- L.lex(s)
    P.parse(ts)

def main() -> Bool:
  String.eq(show(parse("@d(n)\ndef f(a, /, b: int = n, *c, k=m, **e) -> r:\n    global g\n    for i, in c:\n        del a[i], b\n    else:\n        assert a, s\n    try:\n        raise E(a) from b\n    except (E, F) as x:\n        return lambda y, *z: y\n    finally:\n        with (a as p, b): pass\n")), ("{\"tag\":\"Module\",\"body\":[{\"tag\":\"FunctionDef\",\"name\":\"f\",\"args\":{\"tag\":\"arguments\",\"posonlyargs\":[{\"tag\":\"arg\",\"arg\":\"a\",\"annotation\":null,\"type_comment\":null,\"_loc\":[2,6,2,7]}],\"args\":[{\"tag\":\"arg\",\"arg\":\"b\",\"annotation\":{\"tag\":\"Name\",\"id\":\"int\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[2,15,2,18]},\"type_comment\":null,\"_loc\":[2,12,2,18]}],\"vararg\":{\"tag\":\"arg\",\"arg\":\"c\",\"annotation\":null,\"type_comment\":null,\"_loc\":[2,25,2,26]},\"kwonlyar" ++ "gs\":[{\"tag\":\"arg\",\"arg\":\"k\",\"annotation\":null,\"type_comment\":null,\"_loc\":[2,28,2,29]}],\"kw_defaults\":[{\"tag\":\"Name\",\"id\":\"m\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[2,30,2,31]}],\"kwarg\":{\"tag\":\"arg\",\"arg\":\"e\",\"annotation\":null,\"type_comment\":null,\"_loc\":[2,35,2,36]},\"defaults\":[{\"tag\":\"Name\",\"id\":\"n\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[2,21,2,22]}]},\"body\":[{\"tag\":\"Global\",\"names\":[\"g\"],\"_loc\":[3,4,3,12]},{\"tag\":\"For\",\"target\":{\"tag\":\"Tup" ++ "le\",\"elts\":[{\"tag\":\"Name\",\"id\":\"i\",\"ctx\":{\"tag\":\"Store\"},\"_loc\":[4,8,4,9]}],\"ctx\":{\"tag\":\"Store\"},\"_loc\":[4,8,4,10]},\"iter\":{\"tag\":\"Name\",\"id\":\"c\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[4,14,4,15]},\"body\":[{\"tag\":\"Delete\",\"targets\":[{\"tag\":\"Subscript\",\"value\":{\"tag\":\"Name\",\"id\":\"a\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[5,12,5,13]},\"slice\":{\"tag\":\"Name\",\"id\":\"i\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[5,14,5,15" ++ "]},\"ctx\":{\"tag\":\"Del\"},\"_loc\":[5,12,5,16]},{\"tag\":\"Name\",\"id\":\"b\",\"ctx\":{\"tag\":\"Del\"},\"_loc\":[5,18,5,19]}],\"_loc\":[5,8,5,19]}],\"orelse\":[{\"tag\":\"Assert\",\"test\":{\"tag\":\"Name\",\"id\":\"a\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[7,15,7,16]},\"msg\":{\"tag\":\"Name\",\"id\":\"s\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[7,18,7,19]},\"_loc\":[7,8,7,19]}],\"type_comment\":null,\"_loc\":[4,4,7,19]},{\"tag\":\"Try\",\"body\":[{\"tag\":\"Raise\",\"exc\":{\"tag\":\"Call\",\"func\":{\"t" ++ "ag\":\"Name\",\"id\":\"E\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[9,14,9,15]},\"args\":[{\"tag\":\"Name\",\"id\":\"a\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[9,16,9,17]}],\"keywords\":[],\"_loc\":[9,14,9,18]},\"cause\":{\"tag\":\"Name\",\"id\":\"b\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[9,24,9,25]},\"_loc\":[9,8,9,25]}],\"handlers\":[{\"tag\":\"ExceptHandler\",\"type\":{\"tag\":\"Tuple\",\"elts\":[{\"tag\":\"Name\",\"id\":\"E\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[10,12,10,13]},{\"tag\":\"Name\",\"id\":\"F\",\"c" ++ "tx\":{\"tag\":\"Load\"},\"_loc\":[10,15,10,16]}],\"ctx\":{\"tag\":\"Load\"},\"_loc\":[10,11,10,17]},\"name\":\"x\",\"body\":[{\"tag\":\"Return\",\"value\":{\"tag\":\"Lambda\",\"args\":{\"tag\":\"arguments\",\"posonlyargs\":[],\"args\":[{\"tag\":\"arg\",\"arg\":\"y\",\"annotation\":null,\"type_comment\":null,\"_loc\":[11,22,11,23]}],\"vararg\":{\"tag\":\"arg\",\"arg\":\"z\",\"annotation\":null,\"type_comment\":null,\"_loc\":[11,26,11,27]},\"kwonlyargs\":[],\"kw_defaults\":" ++ "[],\"kwarg\":null,\"defaults\":[]},\"body\":{\"tag\":\"Name\",\"id\":\"y\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[11,29,11,30]},\"_loc\":[11,15,11,30]},\"_loc\":[11,8,11,30]}],\"_loc\":[10,4,11,30]}],\"orelse\":[],\"finalbody\":[{\"tag\":\"With\",\"items\":[{\"tag\":\"withitem\",\"context_expr\":{\"tag\":\"Name\",\"id\":\"a\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[13,14,13,15]},\"optional_vars\":{\"tag\":\"Name\",\"id\":\"p\",\"ctx\":{\"tag\":\"Store\"},\"_loc\":[13,19,13,20]}},{\"tag\":\"withitem\",\"context_e" ++ "xpr\":{\"tag\":\"Name\",\"id\":\"b\",\"ctx\":{\"tag\":\"Load\"},\"_loc\":[13,22,13,23]},\"optional_vars\":null}],\"body\":[{\"tag\":\"Pass
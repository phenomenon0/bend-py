# The T2 milestone: `repo_of` (llm-wiki tools/overview.py:15-23, verbatim; unannotated,
# so its reviewed signature comes as a stub) through lex -> parse -> elaborate -> verify
# -> emit: if/or/not-in, guarded split, Optional narrowing and the for-fold as helper
# matches. The expected block is the emitted file plus its span map; the judge compiles
# the same text.
import Base
import ../../demos/python/syntax.bend as S
import ../../demos/python/translate.bend as Tr

def show(r: Result<&2, &2, S.Error, String>) -> String:
  match r:
    case Done{s}:
      s
    case Fail{e}:
      S.error_text(e)

def main() -> String:
  show(Tr.translate_as("def repo_of(pid, slugs):\n    if pid.startswith('SRC-') or '.' not in pid:\n        return None\n    tail = pid.split('.', 1)[1]\n    best = None\n    for s in slugs:\n        if tail == s or tail.startswith(s + '-'):\n            best = s if best is None or len(s) > len(best) else best\n    return best\n", "def repo_of(pid: str, slugs: list[str]) -> str | None:\n    pass\n", Tr.contracts(), "repo_of"))
#|"# Faithful translation (tiers 1-2) of Python `repo_of` 1:0-9:15 by demos/python/translate.bend.\nimport Base\n\ndef Py.after(+s: String, +sep: String) -> String:\n  Pair.snd(String, String, Pair.snd(String, String & String, String.partition(s, sep)))\n\ndef repo_of.or_2_7(_c: Bool, pid: String) -> Bool:\n  match _c:\n    case True{}:\n      True{}\n    case False{}:\n      Bool.not(String.contains(pid, \".\"))\n\ndef repo_of.or_7_11(_c: Bool, s: String, tail: String) -> Bool:\n  match _c:\n    case True{}:\n      True{}\n    case False{}:\n      String.starts_with(tail, String.append(s, \"-\"))\n\ndef repo_of.opt_8_24(best: Maybe<&2, String>, s: String) -> Bool:\n  match best:\n    case None{}:\n      True{}\n    case Some{best}:\n      Nat.is_gt(String.length(s), String.length(best))\n\ndef repo_of.if_8_19(_c: Bool, best: Maybe<&2, String>, s: String) -> Maybe<&2, String>:\n  match _c:\n    case True{}:\n      Some{s}\n    case False{}:\n      best\n\ndef repo_of.if_7_8(_c: Bool, +best: Maybe<&2, String>, +s: String) -> Maybe<&2, String>:\n  match _c:\n    case True{}:\n      best = {repo_of.if_8_19(repo_of.opt_8_24(best, s), best, s) : Maybe<&2, String>}\n      best\n    case False{}:\n      best\n\ndef repo_of.for_6_4(_xs: List<&2, String>, best: Maybe<&2, String>, +tail: String) -> Maybe<&2, String>:\n  match _xs:\n    case Nil{}:\n      best\n    case Con{+s, _rest}:\n      repo_of.for_6_4(_rest, repo_of.if_7_8(repo_of.or_7_11(String.eq(tail, s), s, tail), best, s), tail)\n\ndef repo_of.if_2_4(_c: Bool, pid: String, slugs: List<&2, String>) -> Maybe<&2, String>:\n  match _c:\n    case True{}:\n      None{}\n    case False{}:\n      tail = {Py.after(pid, \".\") : String}\n      best = {None{} : Maybe<&2, String>}\n      best = {repo_of.for_6_4(slugs, best, tail) : Maybe<&2, String>}\n      best\n\ndef repo_of(+pid: String, slugs: List<&2, String>) -> Maybe<&2, String>:\n  repo_of.if_2_4(repo_of.or_2_7(String.starts_with(pid, \"SRC-\"), pid), pid, slugs)\n\n# spans: emitted Bend <- Python source, node : type\n# 10:6-10:12 <- py 2:7-2:47 Lit True{} : Bool\n# 12:6-12:41 <- py 2:33-2:47 Prim Bool.not : Bool\n# 12:15-12:40 <- py 2:33-2:47 Prim String.contains : Bool\n# 12:31-12:34 <- py 2:44-2:47 Var pid : String\n# 12:36-12:39 <- py 2:33-2:36 Lit \".\" : String\n# 17:6-17:12 <- py 7:11-7:48 Lit True{} : Bool\n# 19:6-19:53 <- py 7:24-7:48 Prim String.starts_with : Bool\n# 19:25-19:29 <- py 7:24-7:28 Var tail : String\n# 19:31-19:52 <- py 7:40-7:47 Prim String.append : String\n# 19:45-19:46 <- py 7:40-7:41 Var s : String\n# 19:48-19:51 <- py 7:44-7:47 Lit \"-\" : String\n# 24:6-24:12 <- py 8:24-8:58 Lit True{} : Bool\n# 26:6-26:54 <- py 8:40-8:58 Prim Nat.is_gt : Bool\n# 26:16-26:32 <- py 8:40-8:46 Prim String.length : Nat\n# 26:30-26:31 <- py 8:44-8:45 Var s : String\n# 26:34-26:53 <- py 8:49-8:58 Prim String.length : Nat\n# 26:48-26:52 <- py 8:53-8:57 Var best : String\n# 31:6-31:13 <- py 8:19-8:20 Some : Maybe<&2, String>\n# 31:11-31:12 <- py 8:19-8:20 Var s : String\n# 33:6-33:10 <- py 8:64-8:68 Var best : Maybe<&2, String>\n# 38:6-38:86 <- py 8:12-8:68 Let best : Maybe<&2, String>\n# 38:14-38:65 <- py 8:19-8:68 Branch if : Maybe<&2, String>\n# 38:30-38:55 <- py 8:24-8:58 Opt best : Bool\n# 39:6-39:10 <- py 8:12-8:68 Var best : Maybe<&2, String>\n# 41:6-41:10 <- py 7:8-8:68 Var best : Maybe<&2, String>\n# 48:29-48:98 <- py 7:8-8:68 Branch if : Maybe<&2, String>\n# 48:44-48:88 <- py 7:11-7:48 Branch or : Bool\n# 48:60-48:78 <- py 7:11-7:20 Prim String.eq : Bool\n# 48:70-48:74 <- py 7:11-7:15 Var tail : String\n# 48:76-48:77 <- py 7:19-7:20 Var s : String\n# 53:6-53:12 <- py 3:8-3:19 Return : Maybe<&2, String>\n# 53:6-53:12 <- py 3:15-3:19 Lit None{} : Maybe<&2, String>\n# 55:6-55:42 <- py 4:4-4:31 Let tail : String\n# 55:14-55:32 <- py 4:11-4:31 Prim Py.after : String\n# 55:23-55:26 <- py 4:11-4:14 Var pid : String\n# 55:28-55:31 <- py 4:21-4:24 Lit \".\" : String\n# 56:6-56:41 <- py 5:4-5:15 Let best : Maybe<&2, String>\n
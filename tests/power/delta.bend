# Delta against CPython's own Counter (delta_gen.py prints this file). A row is
# "{e:+w e:-w}", elements ascending, weights signed, and an element whose
# weights cancelled is not in it at all. raw() prints a Z-set as built; line()
# consolidates first, which is the canonical form every comparison is made in.
#
# The file's spine: for every operator, the recompute from scratch and the
# incremental path are two separate rows pinned to the same expected string.
import Base
import ../../power/vec.bend as Vec
import ../../power/delta.bend as Delta

# the element encoding: k * 256 + v, key in the high bits, payload in the low
# byte. jf is asymmetric on purpose, so a join that swaps its sides is caught.
def kf(x: U32) -> U32:
  U32.shrn(x, 8n)

def jf(x: U32, y: U32) -> U32:
  U32.add(U32.shln(x, 8n), U32.and(y, 255))

def mf(x: U32) -> U32:
  U32.shrn(x, 8n)

def pf(x: U32) -> Bool:
  U32.is_lt(U32.and(x, 255), 128)

def vf(x: U32) -> U32:
  U32.and(x, 255)

def zs(es: List<&2, U32>, ws: List<&2, U32>) -> Delta.ZSet:
  Delta.of_lists(es, ws)

def txt(r: Delta.ZSet & String) -> String:
  (z, s) = r
  s

def raw(z: Delta.ZSet) -> String:
  txt(Delta.show(z))

def line(z: Delta.ZSet) -> String:
  raw(Delta.consolidate(z))

def num(r: Delta.ZSet & U32) -> String:
  (z, n) = r
  U32.show(n)

def sw(r: Delta.ZSet & U32) -> String:
  (z, n) = r
  Delta.wshow(n)

def yn(b: Bool) -> String:
  match b:
    case True{}:
      "1"
    case False{}:
      "0"

def jz(j: Delta.Jn) -> Delta.ZSet:
  match j:
    case Delta.Jn{left, a, b, out, ok}:
      out

def jout(j: Delta.Jn) -> String:
  line(jz(j))

def jok(j: Delta.Jn) -> String:
  match j:
    case Delta.Jn{left, a, b, out, ok}:
      yn(ok) ++ ":" ++ U32.show(left)

def ix(z: Delta.ZSet) -> Delta.Ix:
  Delta.index(~kf, z)

def ixline(x: Delta.Ix) -> String:
  line(Delta.unindex(x))

def jn(a: Delta.ZSet, b: Delta.ZSet, lim: U32) -> Delta.Jn:
  Delta.join(~kf, ~jf, a, b, lim)

def jd(a: Delta.ZSet, b: Delta.ZSet, da: Delta.ZSet, db: Delta.ZSet, lim: U32) ->
  Delta.Jn:
  Delta.join_delta(~jf, ix(a), ix(b), ix(da), ix(db), lim)

def ddz(r: Delta.ZSet & Delta.ZSet) -> Delta.ZSet:
  (st, d) = r
  d

def ddout(r: Delta.ZSet & Delta.ZSet) -> String:
  line(ddz(r))

def dd(st: Delta.ZSet, d: Delta.ZSet) -> Delta.ZSet & Delta.ZSet:
  Delta.distinct_delta(Delta.consolidate(st), d)

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(raw(Delta.remove(Delta.insert(Delta.empty(), 5), 5)))
    IO.print(line(Delta.remove(Delta.insert(Delta.empty(), 5), 5)))
    IO.print(line(zs([5, 5, 5], [1, 1, 1])))
    IO.print(line(zs([5, 5, 5], [1, 2, 4294967294])))
    IO.print(line(zs([5, 5, 5], [1, 4294967293, 2])))
    IO.print(line(zs([5, 5, 5], [4294967295, 4294967295, 4294967295])))
    IO.print(raw(zs([9, 3, 9, 3], [1, 2, 1, 4294967294])))
    IO.print(line(zs([9, 3, 9, 3], [1, 2, 1, 4294967294])))
    IO.print(line(Delta.empty()))
    IO.print(line(Delta.negate(zs([1, 2], [3, 4294967295]))))
    IO.print(line(Delta.plus(zs([3, 7, 9], [2, 4294967295, 4]), zs([7, 9, 11], [1, 4294967292, 5]))))
    IO.print(line(Delta.minus(zs([3, 7, 9], [2, 4294967295, 4]), zs([7, 9, 11], [1, 4294967292, 5]))))
    IO.print(line(Delta.minus(zs([3, 7, 9], [2, 4294967295, 4]), zs([3, 7, 9], [2, 4294967295, 4]))))
    IO.print(line(Delta.plus(zs([3, 7, 9], [2, 4294967295, 4]), Delta.negate(zs([3, 7, 9], [2, 4294967295, 4])))))
    IO.print(num(Delta.size(Delta.consolidate(zs([3, 7, 9], [2, 4294967295, 4])))))
    IO.print(sw(Delta.total(zs([3, 7, 9], [2, 4294967295, 4]))))
    IO.print(num(Delta.size(Delta.consolidate(zs([7, 9, 11], [1, 4294967292, 5])))))
    IO.print(sw(Delta.total(zs([7, 9, 11], [1, 4294967292, 5]))))
    IO.print(num(Delta.size(Delta.consolidate(zs([], [])))))
    IO.print(sw(Delta.total(zs([], []))))
    IO.print(num(Delta.size(Delta.consolidate(zs([4, 6], [4294967291, 5])))))
    IO.print(sw(Delta.total(zs([4, 6], [4294967291, 5]))))
    IO.print(num(Delta.weight(Delta.consolidate(zs([3, 7, 20], [2, 4294967295, 1])), 3)))
    IO.print(num(Delta.weight(Delta.consolidate(zs([3, 7, 20], [2, 4294967295, 1])), 7)))
    IO.print(num(Delta.weight(Delta.consolidate(zs([3, 7, 20], [2, 4294967295, 1])), 20)))
    IO.print(num(Delta.weight(Delta.consolidate(zs([3, 7, 20], [2, 4294967295, 1])), 0)))
    IO.print(num(Delta.weight(Delta.consolidate(zs([3, 7, 20], [2, 4294967295, 1])), 5)))
    IO.print(num(Delta.weight(Delta.consolidate(zs([3, 7, 20], [2, 4294967295, 1])), 99)))
    IO.print(num(Delta.weight(Delta.consolidate(zs([5, 5], [1, 4294967295])), 5)))
    IO.print(line(Delta.map(~mf, zs([1, 259, 260, 261, 513, 517, 770, 771, 772], [4294967294, 1, 1, 4294967294, 2, 4294967295, 3, 2, 1]))))
    IO.print(line(Delta.plus(Delta.map(~mf, zs([1, 259, 261, 513, 771, 772], [4294967294, 1, 4294967294, 2, 2, 1])), Delta.map(~mf, zs([260, 517, 770], [1, 4294967295, 3])))))
    IO.print(line(Delta.filter(~pf, zs([1, 259, 260, 261, 513, 517, 770, 771, 772], [4294967294, 1, 1, 4294967294, 2, 4294967295, 3, 2, 1]))))
    IO.print(line(Delta.plus(Delta.filter(~pf, zs([1, 259, 261, 513, 771, 772], [4294967294, 1, 4294967294, 2, 2, 1])), Delta.filter(~pf, zs([260, 517, 770], [1, 4294967295, 3])))))
    IO.print(line(Delta.map(~mf, zs([3, 257, 258, 514, 515, 768, 769, 770, 1024, 1025, 1280, 1281, 1283], [1, 4294967295, 4294967292, 3, 4, 1, 4294967295, 2, 1, 1, 3, 4294967295, 2]))))
    IO.print(line(Delta.plus(Delta.map(~mf, zs([3, 257, 258, 514, 768, 770, 1024, 1025, 1280, 1281, 1283], [1, 4294967295, 4294967292, 3, 1, 2, 1, 1, 4294967294, 4294967295, 2])), Delta.map(~mf, zs([515, 769, 1280], [4, 4294967295, 5])))))
    IO.print(line(Delta.filter(~pf, zs([3, 257, 258, 514, 515, 768, 769, 770, 1024, 1025, 1280, 1281, 1283], [1, 4294967295, 4294967292, 3, 4, 1, 4294967295, 2, 1, 1, 3, 4294967295, 2]))))
    IO.print(line(Delta.plus(Delta.filter(~pf, zs([3, 257, 258, 514, 768, 770, 1024, 1025, 1280, 1281, 1283], [1, 4294967295, 4294967292, 3, 1, 2, 1, 1, 4294967294, 4294967295, 2])), Delta.filter(~pf, zs([515, 769, 1280], [4, 4294967295, 5])))))
    IO.print(line(Delta.map(~mf, zs([2, 257, 513], [2, 2, 4294967294]))))
    IO.print(line(Delta.plus(Delta.map(~mf, zs([1, 2, 513], [4294967295, 2, 4294967294])), Delta.map(~mf, zs([1, 257], [1, 2])))))
    IO.print(line(Delta.filter(~pf, zs([2, 257, 513], [2, 2, 4294967294]))))
    IO.print(line(Delta.plus(Delta.filter(~pf, zs([1, 2, 513], [4294967295, 2, 4294967294])), Delta.filter(~pf, zs([1, 257], [1, 2])))))
    IO.print(line(Delta.map(~mf, zs([3, 256, 512, 516], [3, 3, 4294967294, 4294967294]))))
    IO.print(line(Delta.plus(Delta.map(~mf, zs([], [])), Delta.map(~mf, zs([3, 256, 512, 516], [3, 3, 4294967294, 4294967294])))))
    IO.print(line(Delta.filter(~pf, zs([3, 256, 512, 516], [3, 3, 4294967294, 4294967294]))))
    IO.print(line(Delta.plus(Delta.filter(~pf, zs([], [])), Delta.filter(~pf, zs([3, 256, 512, 516], [3, 3, 4294967294, 4294967294])))))
    IO.print(line(Delta.aggregate_delta(~kf, ~vf, zs([0, 4, 5, 259, 512, 513, 515, 517, 769, 775], [2, 2, 1, 1, 4294967295, 4294967295, 7, 1, 3, 2]))))
    IO.print(line(Delta.plus(Delta.aggregate_delta(~kf, ~vf, zs([4, 5, 259, 513, 515, 769, 775], [2, 1, 1, 4294967295, 5, 3, 2])), Delta.aggregate_delta(~kf, ~vf, zs([0, 512, 515, 517], [2, 4294967295, 2, 1])))))
    IO.print(line(Delta.group(~kf, zs([0, 4, 5, 259, 512, 513, 515, 517, 769, 775], [2, 2, 1, 1, 4294967295, 4294967295, 7, 1, 3, 2]))))
    IO.print(line(Delta.plus(Delta.group(~kf, zs([4, 5, 259, 513, 515, 769, 775], [2, 1, 1, 4294967295, 5, 3, 2])), Delta.group(~kf, zs([0, 512, 515, 517], [2, 4294967295, 2, 1])))))
    IO.print(line(Delta.aggregate_delta(~kf, ~vf, zs([4, 258, 259, 513, 514, 515, 770, 1025, 1028], [1, 1, 4294967295, 4294967295, 1, 3, 3, 4294967294, 4]))))
    IO.print(line(Delta.plus(Delta.aggregate_delta(~kf, ~vf, zs([4, 258, 513, 514, 515, 770, 1025, 1028], [1, 1, 4294967295, 3, 3, 3, 4294967294, 3])), Delta.aggregate_delta(~kf, ~vf, zs([259, 514, 1028], [4294967295, 4294967294, 1])))))
    IO.print(line(Delta.group(~kf, zs([4, 258, 259, 513, 514, 515, 770, 1025, 1028], [1, 1, 4294967295, 4294967295, 1, 3, 3, 4294967294, 4]))))
    IO.print(line(Delta.plus(Delta.group(~kf, zs([4, 258, 513, 514, 515, 770, 1025, 1028], [1, 1, 4294967295, 3, 3, 3, 4294967294, 3])), Delta.group(~kf, zs([259, 514, 1028], [4294967295, 4294967294, 1])))))
    IO.print(line(Delta.aggregate_delta(~kf, ~vf, zs([], []))))
    IO.print(line(Delta.plus(Delta.aggregate_delta(~kf, ~vf, zs([256, 257], [1, 2])), Delta.aggregate_delta(~kf, ~vf, zs([256, 257], [4294967295, 4294967294])))))
    IO.print(line(Delta.group(~kf, zs([], []))))
    IO.print(line(Delta.plus(Delta.group(~kf, zs([256, 257], [1, 2])), Delta.group(~kf, zs([256, 257], [4294967295, 4294967294])))))
    IO.print(ixline(ix(zs([3, 257, 259, 513, 515, 516, 769, 1026, 1028, 1281], [2, 1, 4294967294, 4294967295, 2, 1, 3, 4294967295, 2, 1]))))
    IO.print(ixline(ix(zs([0, 7, 256, 257], [4294967295, 4294967292, 2, 4]))))
    IO.print(ixline(ix(zs([], []))))
    IO.print(ixline(ix(zs([1], [1]))))
    IO.print(jout(jn(zs([0, 1, 3, 257, 515], [4294967294, 4294967295, 3, 1, 4294967295]), zs([3, 256, 257, 512, 513, 514, 515], [1, 1, 6, 4294967295, 4294967294, 3, 4294967295]), 4294967295)))
    IO.print(line(Delta.plus(jz(jn(zs([0, 1, 257], [4294967294, 4294967295, 1]), zs([3, 257, 512, 513, 514], [1, 6, 4294967295, 4294967294, 3]), 4294967295)), jz(jd(zs([0, 1, 257], [4294967294, 4294967295, 1]), zs([3, 257, 512, 513, 514], [1, 6, 4294967295, 4294967294, 3]), zs([3, 515], [3, 4294967295]), zs([256, 515], [1, 4294967295]), 4294967295)))))
    IO.print(jout(jd(zs([0, 1, 257], [4294967294, 4294967295, 1]), zs([3, 257, 512, 513, 514], [1, 6, 4294967295, 4294967294, 3]), zs([3, 515], [3, 4294967295]), zs([256, 515], [1, 4294967295]), 4294967295)))
    IO.print(jout(jn(zs([0, 1, 2, 256, 257, 514, 768, 769], [2, 1, 4294967294, 2, 1, 1, 2, 2]), zs([2, 258, 512, 768, 770], [4294967295, 4294967294, 4, 4294967294, 3]), 4294967295)))
    IO.print(line(Delta.plus(jz(jn(zs([2, 256, 257, 514, 768, 769], [4294967294, 2, 2, 1, 2, 2]), zs([2, 258, 512, 768, 770], [4294967295, 4294967294, 4, 4294967294, 3]), 4294967295)), jz(jd(zs([2, 256, 257, 514, 768, 769], [4294967294, 2, 2, 1, 2, 2]), zs([2, 258, 512, 768, 770], [4294967295, 4294967294, 4, 4294967294, 3]), zs([0, 1, 257], [2, 1, 4294967295]), zs([], []), 4294967295)))))
    IO.print(jout(jd(zs([2, 256, 257, 514, 768, 769], [4294967294, 2, 2, 1, 2, 2]), zs([2, 258, 512, 768, 770], [4294967295, 4294967294, 4, 4294967294, 3]), zs([0, 1, 257], [2, 1, 4294967295]), zs([], []), 4294967295)))
    IO.print(jout(jn(zs([1, 2, 256, 258, 513, 768, 769], [4294967295, 2, 3, 4294967294, 4294967295, 1, 4294967294]), zs([0, 1, 257, 512, 769], [4294967294, 2, 6, 2, 3]), 4294967295)))
    IO.print(line(Delta.plus(jz(jn(zs([1, 2, 256, 258, 513, 768, 769], [4294967295, 2, 3, 4294967294, 4294967295, 1, 4294967294]), zs([0, 1, 257, 512, 513, 769], [4294967294, 3, 6, 1, 1, 3]), 4294967295)), jz(jd(zs([1, 2, 256, 258, 513, 768, 769], [4294967295, 2, 3, 4294967294, 4294967295, 1, 4294967294]), zs([0, 1, 257, 512, 513, 769], [4294967294, 3, 6, 1, 1, 3]), zs([], []), zs([1, 512, 513], [4294967295, 1, 4294967295]), 4294967295)))))
    IO.print(jout(jd(zs([1, 2, 256, 258, 513, 768, 769], [4294967295, 2, 3, 4294967294, 4294967295, 1, 4294967294]), zs([0, 1, 257, 512, 513, 769], [4294967294, 3, 6, 1, 1, 3]), zs([], []), zs([1, 512, 513], [4294967295, 1, 4294967295]), 4294967295)))
    IO.print(jout(jn(zs([2, 257, 260], [1, 4294967293, 4294967294]), zs([1, 3, 257, 258, 259, 260], [1, 2, 4294967295, 2, 4294967295, 2]), 4294967295)))
    IO.print(line(Delta.plus(jz(jn(zs([2, 256, 257, 260], [1, 4294967294, 4294967294, 4294967294]), zs([1, 258, 259, 260], [1, 2, 4294967295, 2]), 4294967295)), jz(jd(zs([2, 256, 257, 260], [1, 4294967294, 4294967294, 4294967294]), zs([1, 258, 259, 260], [1, 2, 4294967295, 2]), zs([256, 257], [2, 4294967295]), zs([3, 257], [2, 4294967295]), 4294967295)))))
    IO.print(jout(jd(zs([2, 256, 257, 260], [1, 4294967294, 4294967294, 4294967294]), zs([1, 258, 259, 260], [1, 2, 4294967295, 2]), zs([256, 257], [2, 4294967295]), zs([3, 257], [2, 4294967295]), 4294967295)))
    IO.print(jout(jn(zs([1, 1283], [1, 1]), zs([2, 1284], [1, 1]), 4294967295)))
    IO.print(line(Delta.plus(jz(jn(zs([1], [1]), zs([2], [1]), 4294967295)), jz(jd(zs([1], [1]), zs([2], [1]), zs([1283], [1]), zs([1284], [1]), 4294967295)))))
    IO.print(jout(jd(zs([1], [1]), zs([2], [1]), zs([1283], [1]), zs([1284], [1]), 4294967295)))
    IO.print(jout(jn(zs([1, 259, 513], [3, 1, 2]), zs([2, 513], [1, 1]), 4294967295)))
    IO.print(line(Delta.plus(jz(jn(zs([], []), zs([], []), 4294967295)), jz(jd(zs([], []), zs([], []), zs([1, 259, 513], [3, 1, 2]), zs([2, 513], [1, 1]), 4294967295)))))
    IO.print(jout(jd(zs([], []), zs([], []), zs([1, 259, 513], [3, 1, 2]), zs([2, 513], [1, 1]), 4294967295)))
    IO.print(jout(jn(zs([1283], [1]), zs([1284], [1]), 4294967295)))
    IO.print(jout(jn(zs([1, 257, 259, 514], [1, 4294967295, 1, 2]), zs([2, 3, 259, 512], [4, 4294967294, 4294967295, 1]), 4294967295)))
    IO.print(jout(jn(zs([2, 3, 259, 512], [4, 4294967294, 4294967295, 1]), zs([1, 257, 259, 514], [1, 4294967295, 1, 2]), 4294967295)))
    IO.print(jok(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 4294967295)))
    IO.print(jok(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 9)))
    IO.print(jok(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 10)))
    IO.print(jok(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 8)))
    IO.print(jok(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 1)))
    IO.print(jok(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 0)))
    IO.print(jout(jn(zs([0, 2, 257, 258, 259], [3, 2, 3, 1, 4294967295]), zs([0, 1, 2, 257], [2, 2, 4294967295, 3]), 9)))
    IO.print(jok(jd(zs([256, 257, 258, 513], [4294967294, 4294967294, 2, 2]), zs([1, 257, 259, 515], [3, 4294967295, 1, 4]), zs([2, 259], [2, 4294967294]), zs([0, 258], [4294967295, 3]), 4294967295)))
    IO.print(jok(jd(zs([256, 257, 258, 513], [4294967294, 4294967294, 2, 2]), zs([1, 257, 259, 515], [3, 4294967295, 1, 4]), zs([2, 259], [2, 4294967294]), zs([0, 258], [4294967295, 3]), 8)))
    IO.print(jok(jd(zs([256, 257, 258, 513], [4294967294, 4294967294, 2, 2]), zs([1, 257, 259, 515], [3, 4294967295, 1, 4]), zs([2, 259], [2, 4294967294]), zs([0, 258], [4294967295, 3]), 7)))
    IO.print(jok(jd(zs([256, 257, 258, 513], [4294967294, 4294967294, 2, 2]), zs([1, 257, 259, 515], [3, 4294967295, 1, 4]), zs([2, 259], [2, 4294967294]), zs([0, 258], [4294967295, 3]), 0)))
    IO.print(line(Delta.distinct(zs([256, 257, 258], [2, 1, 1]))))
    IO.print(ddout(dd(zs([256, 257], [1, 1]), zs([256, 258], [1, 1]))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256, 257], [1, 1])), ddz(dd(zs([256, 257], [1, 1]), zs([256, 258], [1, 1]))))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256, 257], [1, 1])), Delta.distinct(zs([256, 258], [1, 1])))))
    IO.print(line(Delta.distinct(zs([257], [1]))))
    IO.print(ddout(dd(zs([256, 257], [1, 2]), zs([256, 257], [4294967295, 4294967295]))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256, 257], [1, 2])), ddz(dd(zs([256, 257], [1, 2]), zs([256, 257], [4294967295, 4294967295]))))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256, 257], [1, 2])), Delta.distinct(zs([256, 257], [4294967295, 4294967295])))))
    IO.print(line(Delta.distinct(zs([512], [3]))))
    IO.print(ddout(dd(zs([256], [2]), zs([256, 512], [4294967294, 3]))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256], [2])), ddz(dd(zs([256], [2]), zs([256, 512], [4294967294, 3]))))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256], [2])), Delta.distinct(zs([256, 512], [4294967294, 3])))))
    IO.print(line(Delta.distinct(zs([256, 257], [1, 4294967295]))))
    IO.print(ddout(dd(zs([], []), zs([256, 257], [1, 4294967295]))))
    IO.print(line(Delta.plus(Delta.distinct(zs([], [])), ddz(dd(zs([], []), zs([256, 257], [1, 4294967295]))))))
    IO.print(line(Delta.plus(Delta.distinct(zs([], [])), Delta.distinct(zs([256, 257], [1, 4294967295])))))
    IO.print(line(Delta.distinct(zs([256], [1]))))
    IO.print(ddout(dd(zs([256], [4294967295]), zs([256], [2]))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256], [4294967295])), ddz(dd(zs([256], [4294967295]), zs([256], [2]))))))
    IO.print(line(Delta.plus(Delta.distinct(zs([256], [4294967295])), Delta.distinct(zs([256], [2])))))
    IO.print(line(Delta.distinct(zs([0, 257, 514, 768, 769, 770, 771], [4, 1, 4294967295, 3, 4294967292, 4294967294, 5]))))
    IO.print(ddout(dd(zs([0, 257, 514, 768, 769, 770, 771], [4, 1, 4294967295, 3, 4294967295, 4294967294, 1]), zs([769, 771], [4294967293, 4]))))
    IO.print(line(Delta.plus(Delta.distinct(zs([0, 257, 514, 768, 769, 770, 771], [4, 1, 4294967295, 3, 4294967295, 4294967294, 1])), ddz(dd(zs([0, 257, 514, 768, 769, 770, 771], [4, 1, 4294967295, 3, 4294967295, 4294967294, 1]), zs([769, 771], [4294967293, 4]))))))
    IO.print(line(Delta.plus(Delta.distinct(zs([0, 257, 514, 768, 769, 770, 771], [4, 1, 4294967295, 3, 4294967295, 4294967294, 1])), Delta.distinct(zs([769, 771], [4294967293, 4])))))
    IO.print(line(Delta.distinct(zs([1, 2, 3], [5, 4294967294, 1]))))
    IO.print(line(Delta.distinct(zs([1, 1], [2, 4294967294]))))
    IO.print(ixline(Delta.absorb(~kf, ix(zs([0, 1, 257], [4294967294, 4294967295, 1])), ix(zs([3, 515], [3, 4294967295])))))
    IO.print(ixline(Delta.absorb(~kf, ix(zs([2, 256, 257, 514, 768, 769], [4294967294, 2, 2, 1, 2, 2])), ix(zs([0, 1, 257], [2, 1, 4294967295])))))

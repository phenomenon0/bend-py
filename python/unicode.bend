# CPython 3.11.15 tokenize NAME uses Unicode \w (Unicode 14.0.0).
# Sorted scalar ranges, generated from that pinned oracle; no host dependency.
import Base
import ./syntax.bend as S

type Ranges is Data:
  Empty{}
  Range{lo: U32, hi: U32, lower: Ranges, upper: Ranges}

def member(rs: Ranges, +n: U32) -> Bool:
  match rs:
    case Empty{}:
      False{}
    case Range{lo, hi, lower, upper}:
      S.choose(Bool, U32.is_lt(n, lo), u => member(lower, n), u =>
        S.choose(Bool, U32.is_gt(n, hi), u => member(upper, n), u => True{}))


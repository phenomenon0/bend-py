# Text: identity over bytes. UTF-8 in and out with the offset of every code
# point, extended grapheme cluster boundaries (UAX #29), and a normalizer that
# hands back the map from the normalized text to the byte ranges of the
# original it came from -- so a search can normalize hard while a citation
# stays exact.
#
# The map is the lane. Normalization is not injective, so the offsets cannot be
# recovered afterwards: either they come out of the pass that destroyed them or
# they do not exist. norm therefore does not answer bytes, it answers
# Norm{out, src, dst} -- the normalized bytes and the same list of segments in
# two coordinate systems. back(o) is a binary search of dst and one read of
# src; fwd(o) is the same two steps the other way.
#
# A segment is a starter-led run: the boundary sits in front of every code
# point that nothing before it can compose with. Inside a segment the
# normalizer reorders and composes freely, so the map is per segment and not
# per code point. That is what makes the law hold by construction rather than
# by luck:
#
#   for every normalized offset o, with (s, e) = back(o),
#   norm(original[s..e]) is exactly the normalized bytes of that segment
#
# and tests/power/text.bend pins it as a row on every fixture string, on both
# sides, in both directions.
#
# Coverage is a ceiling, not an oversight. Stated exactly:
#
#   decode / encode / valid / size    all of U+0000..U+10FFFF
#
#   graphemes                         exact for U+0000..U+02FF, U+0300..U+036F,
#                                     the Prepend code points of Arabic and
#                                     Malayalam, Devanagari U+0900..U+097F,
#                                     Hangul U+1100..U+11FF and U+AC00..U+D7A3,
#                                     U+1E00..U+1EFF, U+200B..U+200D,
#                                     U+2028..U+2029, U+203C, U+2049,
#                                     U+2600..U+27BF, U+2B00..U+2BFF,
#                                     U+FE00..U+FE0F, U+FEFF and the emoji and
#                                     regional-indicator blocks of plane 1.
#                                     Every other code point is classed Other,
#                                     which is right for letters and wrong for
#                                     a combining mark outside U+0300..U+036F:
#                                     Hebrew, Thai and the other Indic scripts
#                                     would split a cluster that should hold.
#                                     GB9c, the Indic conjunct rule, is out of
#                                     scope in every script.
#
#   norm (Nfd, Nfc, Fold)             U+0000..U+036F, U+0385, U+1E00..U+1EFF,
#                                     U+1FC1, U+1FED, U+2260, U+226E..U+226F,
#                                     Hangul U+1100..U+1112, U+1161..U+1175,
#                                     U+11A8..U+11C2 and U+AC00..U+D7A3.
#                                     That set is closed under canonical
#                                     decomposition and canonical composition,
#                                     which is what makes it a coverage claim
#                                     and not a range: no input drawn from it
#                                     can decompose or compose to something
#                                     outside it, so the answer either matches
#                                     the standard or the table is wrong.
#                                     Anything outside passes through unchanged.
#                                     Fold is simple case folding: the ten code
#                                     points in coverage whose full fold is
#                                     longer than one code point -- U+00DF and
#                                     its friends -- are left alone.
#
# Written for the compiled lanes. Each table is one balanced tree of disjoint
# ranges reached by `choose`, which is a constant the backends build once, and
# every loop is the fuel-and-state shape the rest of power/ uses because a def
# outside Base may only call itself back.

import Base
import ./vec.bend as Vec
import ./bytes.bend as By

# -- the tables --------------------------------------------------------------

# One shape for all five: a balanced tree of disjoint, sorted ranges, the shape
# demos/python/unicode.bend already uses for its own table. look on a miss
# answers 0, so every table is built so that 0 is not a legal value and a miss
# is never a row.
type Tab is Data:
  TN{}
  TR{lo: U32, hi: U32, k: U32, lower: Tab, upper: Tab}

def choose(-A: Type, b: Bool, yes: Unit -> A, no: Unit -> A) -> A:
  match b:
    case True{}:
      yes(Unit{})
    case False{}:
      no(Unit{})

def look(t: Tab, +n: U32) -> U32:
  match t:
    case TN{}:
      0
    case TR{lo, hi, k, lower, upper}:
      choose(U32, U32.is_lt(n, lo), u => look(lower, n), u =>
        choose(U32, U32.is_gt(n, hi), u => look(upper, n), u => k))

# Grapheme_Cluster_Break, 54 disjoint ranges, derived from the Unicode
# character database and checked against a reference implementation of the
# UAX #29 rules; see docs/omen/lanes/power-15.md.
def gtab() -> Tab:

,55331,7921,TR{55305,55305,7917,TN{},TN{}},TR{56204,56204,494,TN{},TN{}}}},TR{70662,70662,7708,TR{70404,70404,480,TR{62852,62852,493,TN{},TN{}},TR{70532,70532,481,TN{},TN{}}},TR{71428,71428,560,TR{70790,70790,7709,TN{},TN{}},TR{71556,71556,561,TN{},TN{}}}}},TR{1003526,1003526,7862,TR{994692,994692,7773,TR{990084,990084,7737,TR{989956,989956,7736,TN{},TN{}},TR{994564,994564,7772,TN{},TN{}}},TR{995719,995719,7785,TR{995591,995591,7784,TN{},TN{}},TR{1003522,1003522,7852,TN{},TN{}}}},TR{1006722,1006722,7879,TR{1003654,1003654,7863,TR{1003650,1003650,7853,TN{},TN{}},TR{1006594,1006594,7878,TN{},TN{}}},TR{1009282,1009282,7897,TR{1009154,1009154,7896,TN{},TN{}},TN{}}}}}}}}}

# -- UTF-8 -------------------------------------------------------------------

def size.c(wide: Bool) -> U32:
  match wide:
    case True{}:
      3
    case False{}:
      4

def size.b(+cp: U32, two: Bool) -> U32:
  match two:
    case True{}:
      2
    case False{}:
      size.c(U32.is_lt(cp, 65536))

def size.a(+cp: U32, one: Bool) -> U32:
  match one:
    case True{}:
      1
    case False{}:
      size.b(cp, U32.is_lt(cp, 2048))

# size: the bytes UTF-8 gives a code point
def size(+cp: U32) -> U32:
  size.a(cp, U32.is_lt(cp, 128))

def emit.2(b: Bytes(), +cp: U32) -> Bytes():
  By.push(By.push(b, U32.or(192, U32.shrn(cp, 6n))), U32.or(128, U32.and(cp, 63)))

def emit.3(b: Bytes(), +cp: U32) -> Bytes():
  By.push(By.push(By.push(b, U32.or(224, U32.shrn(cp, 12n))),
    U32.or(128, U32.and(U32.shrn(cp, 6n), 63))), U32.or(128, U32.and(cp, 63)))

def emit.4(b: Bytes(), +cp: U32) -> Bytes():
  By.push(By.push(By.push(By.push(b, U32.or(240, U32.shrn(cp, 18n))),
    U32.or(128, U32.and(U32.shrn(cp, 12n), 63))),
    U32.or(128, U32.and(U32.shrn(cp, 6n), 63))), U32.or(128, U32.and(cp, 63)))

def emit.c(b: Bytes(), +cp: U32, wide: Bool) -> Bytes():
  match wide:
    case True{}:
      emit.3(b, cp)
    case False{}:
      emit.4(b, cp)

def emit.b(b: Bytes(), +cp: U32, two: Bool) -> Bytes():
  match two:
    case True{}:
      emit.2(b, cp)
    case False{}:
      emit.c(b, cp, U32.is_lt(cp, 65536))

def emit.a(b: Bytes(), +cp: U32, one: Bool) -> Bytes():
  match one:
    case True{}:
      By.push(b, cp)
    case False{}:
      emit.b(b, cp, U32.is_lt(cp, 2048))

# emit: append one code point. Unchecked on purpose -- a surrogate or a value
# above U+10FFFF encodes to whatever the arithmetic gives. valid is the door
# that refuses; this is the door that writes.
def emit(b: Bytes(), +cp: U32) -> Bytes():
  emit.a(b, cp, U32.is_lt(cp, 128))

def utf.w(+w: U32, r: Bytes() & U32) -> Bytes() & (U32 & U32):
  (b, acc) = r
  (b, (acc, w))

def utf.fold(+acc: U32, r: Bytes() & U32) -> Bytes() & U32:
  (b, x) = r
  (b, U32.add(U32.shln(acc, 6n), U32.and(x, 63)))

def utf.next(+i: U32, r: Bytes() & U32) -> Bytes() & U32:
  (b, acc) = r
  utf.fold(acc, By.at(b, i))

def utf.2(b: Bytes(), +i: U32, +c0: U32) -> Bytes() & (U32 & U32):
  utf.w(2, utf.fold(U32.and(c0, 31), By.at(b, U32.inc(i))))

def utf.3(b: Bytes(), +i: U32, +c0: U32) -> Bytes() & (U32 & U32):
  utf.w(3, utf.next(U32.add(i, 2), utf.fold(U32.and(c0, 15), By.at(b, U32.inc(i)))))

def utf.4(b: Bytes(), +i: U32, +c0: U32) -> Bytes() & (U32 & U32):
  utf.w(4, utf.next(U32.add(i, 3), utf.next(U32.add(i, 2),
    utf.fold(U32.and(c0, 7), By.at(b, U32.inc(i))))))

def utf.d(b: Bytes(), +i: U32, +c0: U32, three: Bool) -> Bytes() & (U32 & U32):
  match three:
    case True{}:
      utf.3(b, i, c0)
    case False{}:
      utf.4(b, i, c0)

def utf.c(b: Bytes(), +i: U32, +c0: U32, two: Bool) -> Bytes() & (U32 & U32):
  match two:
    case True{}:
      utf.2(b, i, c0)
    case False{}:
      utf.d(b, i, c0, U32.is_lt(c0, 240))

def utf.b(b: Bytes(), +i: U32, +c0: U32, one: Bool) -> Bytes() & (U32 & U32):
  match one:
    case True{}:
      (b, (c0, 1))
    case False{}:
      utf.c(b, i, c0, U32.is_lt(c0, 224))

def utf.a(+i: U32, r: Bytes() & U32) -> Bytes() & (U32 & U32):
  (b, +c0) = r
  utf.b(b, i, c0, U32.is_lt(c0, 128))

# decode: the code point at byte i and the width it took, so a caller walks a
# buffer by adding the second half of the answer and always knows the offset it
# is standing on. Unchecked: it folds what the lead byte promises.
def decode(b: Bytes(), +i: U32) -> Bytes() & (U32 & U32):
  utf.a(i, By.at(b, i))

def cont(+x: U32) -> Bool:
  U32.is_eq(U32.and(x, 192), 128)

# the k-th trailing byte only has to be a continuation if the width reaches it
def val.k(+w: U32, +k: U32, +x: U32) -> Bool:
  Bool.or(U32.is_le(w, k), cont(x))

def lead.c(+c0: U32, three: Bool) -> U32:
  match three:
    case True{}:
      3
    case False{}:
      4

def lead.b(+c0: U32, two: Bool) -> U32:
  match two:
    case True{}:
      2
    case False{}:
      lead.c(c0, U32.is_lt(c0, 240))

def lead.a(+c0: U32, one: Bool) -> U32:
  match one:
    case True{}:
      1
    case False{}:
      lead.b(c0, U32.is_lt(c0, 224))

# lead: the width the lead byte promises, before anything has been checked
def lead(+c0: U32) -> U32:
  lead.a(c0, U32.is_lt(c0, 128))

def cpof.d(+c0: U32, +x1: U32, +x2: U32, +x3: U32, three: Bool) -> U32:
  match three:
    case True{}:
      U32.or(U32.shln(U32.and(c0, 15), 12n),
        U32.or(U32.shln(U32.and(x1, 63), 6n), U32.and(x2, 63)))
    case False{}:
      U32.or(U32.shln(U32.and(c0, 7), 18n), U32.or(U32.shln(U32.and(x1, 63), 12n),
        U32.or(U32.shln(U32.and(x2, 63), 6n), U32.and(x3, 63))))

def cpof.c(+c0: U32, +x1: U32, +x2: U32, +x3: U32, two: Bool) -> U32:
  match two:
    case True{}:
      U32.or(U32.shln(U32.and(c0, 31), 6n), U32.and(x1, 63))
    case False{}:
      cpof.d(c0, x1, x2, x3, U32.is_lt(c0, 240))

def cpof.b(+c0: U32, +x1: U32, +x2: U32, +x3: U32, one: Bool) -> U32:
  match one:
    case True{}:
      c0
    case False{}:
      cpof.c(c0, x1, x2, x3, U32.is_lt(c0, 224))

# cpof: the same fold decode does, off four bytes already in hand
def cpof(+c0: U32, +x1: U32, +x2: U32, +x3: U32) -> U32:
  cpof.b(c0, x1, x2, x3, U32.is_lt(c0, 128))

type Vst is Type:
  VDone{ok: U32, b: Bytes()}
  VMore{i: U32, b: Bytes()}

def val.on(b: Bytes(), +j: U32, done: Bool) -> Vst:
  match done:
    case True{}:
      VDone{1, b}
    case False{}:
      VMore{j, b}

def val.ok(b: Bytes(), +j: U32, +n: U32, good: Bool) -> Vst:
  match good:
    case True{}:
      val.on(b, j, U32.is_ge(j, n))
    case False{}:
      VDone{0, b}

# the three checks that need the decoded value: nothing above U+10FFFF, an
# overlong encoding is one whose code point would have fitted in fewer bytes,
# and a surrogate is never UTF-8
def val.cp(b: Bytes(), +i: U32, +n: U32, +w: U32, +cp: U32, good: Bool) -> Vst:
  val.ok(b, U32.add(i, w), n,
    Bool.and(good, Bool.and(U32.is_le(cp, 1114111),
      Bool.and(U32.is_eq(size(cp), w),
        Bool.not(Bool.and(U32.is_ge(cp, 55296), U32.is_le(cp, 57343)))))))

def val.fin(b: Bytes(), +i: U32, +n: U32, +c0: U32, +x1: U32, +x2: U32, +x3: U32,
  +w: U32) -> Vst:
  val.cp(b, i, n, w, cpof(c0, x1, x2, x3),
    Bool.and(U32.is_le(U32.add(i, w), n),
      Bool.and(Bool.or(U32.is_lt(c0, 128),
        Bool.and(U32.is_ge(c0, 192), U32.is_le(c0, 244))),
        Bool.and(val.k(w, 1, x1), Bool.and(val.k(w, 2, x2), val.k(w, 3, x3))))))

def val.d(+i: U32, +n: U32, +c0: U32, +x1: U32, +x2: U32, r: Bytes() & U32) -> Vst:
  (b, x3) = r
  val.fin(b, i, n, c0, x1, x2, x3, lead(c0))

def val.c(+i: U32, +n: U32, +c0: U32, +x1: U32, r: Bytes() & U32) -> Vst:
  (b, x2) = r
  val.d(i, n, c0, x1, x2, By.at(b, U32.add(i, 3)))

def val.b(+i: U32, +n: U32, +c0: U32, r: Bytes() & U32) -> Vst:
  (b, x1) = r
  val.c(i, n, c0, x1, By.at(b, U32.add(i, 2)))

# the three trailing bytes are read whether the width wants them or not: By.at
# wraps at the capacity, so a read past the end is a junk number and never a
# fault, and one straight-line read beats three branches
def val.a(+i: U32, +n: U32, r: Bytes() & U32) -> Vst:
  (b, c0) = r
  val.b(i, n, c0, By.at(b, U32.inc(i)))

def val.step(b: Bytes(), +i: U32, +n: U32) -> Vst:
  val.a(i, n, By.at(b, i))

def val.go(fuel: Nat, s: Vst, +n: U32) -> Bytes() & Bool:
  match fuel:
    case 0n:
      match s:
        case VDone{ok, b}:
          (b, U32.is_eq(ok, 1))
        case VMore{i, b}:
          (b, False{})
    case 1n++p:
      match s:
        case VDone{ok, b}:
          (b, U32.is_eq(ok, 1))
        case VMore{i, b}:
          val.go(p, val.step(b, i, n), n)

def val.start(b: Bytes(), +n: U32) -> Vst:
  val.on(b, 0, U32.is_zero(n))

def valid.n(r: Bytes() & U32) -> Bytes() & Bool:
  (b, +n) = r
  val.go(U32.to_nat(U32.inc(n)), val.start(b, n), n)

# valid: is every byte part of a well-formed sequence -- no overlong, no
# surrogate, no truncated tail, nothing above U+10FFFF, no stray continuation
def valid(b: Bytes()) -> Bytes() & Bool:
  valid.n(By.len(b))

type Shw is Type:
  SEnd{b: Bytes(), s: String}
  SGo{i: U32, b: Bytes(), s: String}

def cps.mk(b: Bytes(), s: String, +i: U32, +n: U32, done: Bool) -> Shw:
  match done:
    case True{}:
      SEnd{b, s}
    case False{}:
      SGo{i, b, s}

def cps.put2(s: String, +i: U32, +n: U32, b: Bytes(), cw: U32 & U32) -> Shw:
  (c, w) = cw
  +j = U32.add(i, w)
  cps.mk(b, String.append(String.append(s, U32.show(c)), " "), j, n, U32.is_ge(j, n))

def cps.put(s: String, +i: U32, +n: U32, r: Bytes() & (U32 & U32)) -> Shw:
  (b, cw) = r
  cps.put2(s, i, n, b, cw)

def cps.go(fuel: Nat, s: Shw, +n: U32) -> Bytes() & String:
  match fuel:
    case 0n:
      match s:
        case SEnd{b, t}:
          (b, t)
        case SGo{i, b, t}:
          (b, t)
    case 1n++p:
      match s:
        case SEnd{b, t}:
          (b, t)
        case SGo{+i, b, t}:
          cps.go(p, cps.put(t, i, n, decode(b, i)), n)

def cps.start(b: Bytes(), +n: U32) -> Shw:
  cps.mk(b, "", 0, n, U32.is_zero(n))

def cps.n(r: Bytes() & U32) -> Bytes() & String:
  (b, +n) = r
  cps.go(U32.to_nat(U32.inc(n)), cps.start(b, n), n)

# cps: the code points of a buffer, decimal, a space after each. A fixture
# prints numbers and not characters, because a raw character in a test row has
# to survive the file, three backends and a terminal, and a number only has to
# survive arithmetic.
def cps(b: Bytes()) -> Bytes() & String:
  cps.n(By.len(b))

# -- grapheme clusters, UAX #29 ----------------------------------------------

# The break classes gtab() is numbered by:
#   0 Other   1 CR   2 LF   3 Control   4 Extend   5 ZWJ   6 Regional_Indicator
#   7 Prepend   8 SpacingMark   9 L   10 V   11 T   12 LV   13 LVT
#   14 Extended_Pictographic
def gcb.syl(z: Bool) -> U32:
  match z:
    case True{}:
      12
    case False{}:
      13

def gcb.fix(+cp: U32, +k: U32, lv: Bool) -> U32:
  match lv:
    case True{}:
      gcb.syl(U32.is_zero(U32.mod(U32.sub(cp, 44032), 28)))
    case False{}:
      k

# gcb: the break class of a code point. gtab() folds all 11,172 Hangul
# syllables into one LV row because LV and LVT differ by arithmetic and not by
# range: a syllable with no trailing jamo is LV, every other one is LVT.
def gcb(+cp: U32) -> U32:
  +k = look(gtab(), cp)
  gcb.fix(cp, k, U32.is_eq(k, 12))

def gg.if(+k: U32, pic: Bool) -> U32:
  match pic:
    case True{}:
      0
    case False{}:
      k

# Extended_Pictographic is not a class the table walk sees: GB11 is the only
# rule that reads it, and everywhere else a pictograph behaves as Other.
def gg(+k: U32) -> U32:
  gg.if(k, U32.is_eq(k, 14))

# CR, LF and Control are 1, 2 and 3, so GB4 and GB5 are one range test
def gnl(+k: U32) -> Bool:
  Bool.and(U32.is_ge(k, 1), U32.is_le(k, 3))

def in2(+k: U32, +a: U32, +b: U32) -> Bool:
  Bool.or(U32.is_eq(k, a), U32.is_eq(k, b))

# join: GB6 through GB13, in order. p and k are the folded classes, raw is the
# unfolded one GB11 needs, fl carries the three bits GB11 and GB12 remember.
def join(+p: U32, +k: U32, +raw: U32, +fl: U32) -> Bool:
  Bool.or(Bool.or(in2(k, 4, 5), U32.is_eq(k, 8)),
    Bool.or(U32.is_eq(p, 7),
      Bool.or(Bool.and(U32.is_eq(p, 9), Bool.or(in2(k, 9, 10), in2(k, 12, 13))),
        Bool.or(Bool.and(in2(p, 12, 10), in2(k, 10, 11)),
          Bool.or(Bool.and(in2(p, 13, 11), U32.is_eq(k, 11)),
            Bool.or(Bool.and(U32.is_eq(U32.and(fl, 1), 1), U32.is_eq(raw, 14)),
              Bool.and(Bool.and(U32.is_eq(p, 6), U32.is_eq(k, 6)),
                U32.is_eq(U32.and(fl, 4), 4))))))))

# brk: GB3 keeps CR LF together, GB4 and GB5 break at every other control, and
# only then do the join rules get a say. Order is the rule, not an optimisation.
def brk(+p: U32, +k: U32, +raw: U32, +fl: U32) -> Bool:
  Bool.not(Bool.or(Bool.and(U32.is_eq(p, 1), U32.is_eq(k, 2)),
    Bool.and(Bool.not(Bool.or(gnl(p), gnl(k))), join(p, k, raw, fl))))

def bit.of(+v: U32, on: Bool) -> U32:
  match on:
    case True{}:
      v
    case False{}:
      0

def bit.azp(+raw: U32, +fl: U32) -> U32:
  bit.of(1, Bool.and(U32.is_eq(raw, 5), U32.is_eq(U32.and(fl, 2), 2)))

def bit.pict(+raw: U32, +fl: U32) -> U32:
  bit.of(2, Bool.or(U32.is_eq(raw, 14),
    Bool.and(U32.is_eq(U32.and(fl, 2), 2), U32.is_eq(raw, 4))))

def bit.ri(+raw: U32, +fl: U32) -> U32:
  bit.of(4, Bool.and(U32.is_eq(raw, 6), U32.is_eq(U32.and(fl, 4), 0)))

# flag: the three bits carried across one code point.
#   1  the last one was a ZWJ that closed a pictographic run       GB11
#   2  a pictographic run is live -- an ExtPict, then any Extends  GB11
#   4  the regional indicators since the last break are odd        GB12, GB13
# All three are updated whether or not a break was taken, which is what makes
# an odd run of flags break in the middle and not at the end.
def flag(+raw: U32, +fl: U32) -> U32:
  U32.or(U32.or(bit.azp(raw, fl), bit.pict(raw, fl)), bit.ri(raw, fl))

type Gst is Type:
  GEnd{b: Bytes(), v: Vec.Vec}
  GGo{i: U32, q: U32, fl: U32, b: Bytes(), v: Vec.Vec}

def gr.mk(b: Bytes(), v: Vec.Vec, +i: U32, +q: U32, +fl: U32, +n: U32,
  done: Bool) -> Gst:
  match done:
    case True{}:
      GEnd{b, Vec.push(v, i)}
    case False{}:
      GGo{i, q, fl, b, v}

def gr.adv(b: Bytes(), v: Vec.Vec, +i: U32, +w: U32, +raw: U32, +fl: U32,
  +n: U32) -> Gst:
  +j = U32.add(i, w)
  gr.mk(b, v, j, raw, flag(raw, fl), n, U32.is_ge(j, n))

def gr.cut(b: Bytes(), v: Vec.Vec, +i: U32, +w: U32, +raw: U32, +fl: U32,
  +n: U32, cut: Bool) -> Gst:
  match cut:
    case True{}:
      gr.adv(b, Vec.push(v, i), i, w, raw, fl, n)
    case False{}:
      gr.adv(b, v, i, w, raw, fl, n)

def gr.raw(b: Bytes(), v: Vec.Vec, +i: U32, +q: U32, +fl: U32, +n: U32,
  +w: U32, +raw: U32) -> Gst:
  gr.cut(b, v, i, w, raw, fl, n,
    Bool.or(U32.is_eq(q, 255), brk(gg(q), gg(raw), raw, fl)))

def gr.dec2(b: Bytes(), v: Vec.Vec, +i: U32, +q: U32, +fl: U32, +n: U32,
  cw: U32 & U32) -> Gst:
  (cp, w) = cw
  gr.raw(b, v, i, q, fl, n, w, gcb(cp))

def gr.dec(v: Vec.Vec, +i: U32, +q: U32, +fl: U32, +n: U32,
  r: Bytes() & (U32 & U32)) -> Gst:
  (b, cw) = r
  gr.dec2(b, v, i, q, fl, n, cw)

def gr.go(fuel: Nat, s: Gst, +n: U32) -> Bytes() & Vec.Vec:
  match fuel:
    case 0n:
      match s:
        case GEnd{b, v}:
          (b, v)
        case GGo{i, q, fl, b, v}:
          (b, v)
    case 1n++p:
      match s:
        case GEnd{b, v}:
          (b, v)
        case GGo{+i, q, fl, b, v}:
          gr.go(p, gr.dec(v, i, q, fl, n, decode(b, i)), n)

# 255 is the "no previous class" mark: GB1 breaks at the start of text, and a
# class number is never 255, so the first code point always cuts.
def gr.start(b: Bytes(), +n: U32) -> Gst:
  gr.mk(b, Vec.new(0), 0, 255, 0, n, U32.is_zero(n))

def gr.n(r: Bytes() & U32) -> Bytes() & Vec.Vec:
  (b, +n) = r
  gr.go(U32.to_nat(U32.inc(n)), gr.start(b, n), n)

# graphemes: the byte offset every extended grapheme cluster starts at, then the
# length of the buffer as a closing sentinel -- so cluster j is [v[j], v[j+1])
# and the last one is not a special case. An empty buffer gives [0].
def graphemes(b: Bytes()) -> Bytes() & Vec.Vec:
  gr.n(By.len(b))

# -- normalization, UAX #15 --------------------------------------------------

# the Hangul constants of UAX #15 section 3.12, by name:
#   SBase 44032   LBase 4352   VBase 4449   TBase 4519
#   LCount 19   VCount 21   TCount 28   NCount 588   SCount 11172
def syl(+cp: U32) -> Bool:
  Bool.and(U32.is_ge(cp, 44032), U32.is_lt(cp, 55204))

def pushif(v: Vec.Vec, +c: U32, has: Bool) -> Vec.Vec:
  match has:
    case True{}:
      Vec.push(v, c)
    case False{}:
      v

def pushnz(v: Vec.Vec, +c: U32) -> Vec.Vec:
  pushif(v, c, U32.is_gt(c, 0))

def dcp.h(v: Vec.Vec, +i: U32) -> Vec.Vec:
  +r = U32.mod(i, 28)
  pushif(Vec.push(Vec.push(v, U32.add(4352, U32.div(i, 588))),
    U32.add(4449, U32.div(U32.mod(i, 588), 28))), U32.add(4519, r),
    U32.is_gt(r, 0))

# dtab() packs a decomposition of up to three code points into ten bits each --
# every canonical decomposition in coverage is at most three long and none of
# its parts is above U+0342.
def dcp.k(v: Vec.Vec, +cp: U32, +k: U32, has: Bool) -> Vec.Vec:
  match has:
    case True{}:
      pushnz(pushnz(Vec.push(v, U32.and(k, 1023)),
        U32.and(U32.shrn(k, 10n), 1023)), U32.and(U32.shrn(k, 20n), 1023))
    case False{}:
      Vec.push(v, cp)

def dcp.j(v: Vec.Vec, +cp: U32, +k: U32) -> Vec.Vec:
  dcp.k(v, cp, k, U32.is_gt(k, 0))

def dcp.n(v: Vec.Vec, +cp: U32, hang: Bool) -> Vec.Vec:
  match hang:
    case True{}:
      dcp.h(v, U32.sub(cp, 44032))
    case False{}:
      dcp.j(v, cp, look(dtab(), cp))

# dcp: append the full canonical decomposition of one code point. Hangul is
# arithmetic and not a table: 11,172 rows nobody should ship when three
# divisions answer it.
def dcp(v: Vec.Vec, +cp: U32) -> Vec.Vec:
  dcp.n(v, cp, syl(cp))

def ccc(+cp: U32) -> U32:
  look(ctab(), cp)

def lccc.k(+cp: U32, +k: U32, has: Bool) -> U32:
  match has:
    case True{}:
      ccc(U32.and(k, 1023))
    case False{}:
      ccc(cp)

def lccc.j(+cp: U32, +k: U32) -> U32:
  lccc.k(cp, k, U32.is_gt(k, 0))

def lccc.n(+cp: U32, hang: Bool) -> U32:
  match hang:
    case True{}:
      0
    case False{}:
      lccc.j(cp, look(dtab(), cp))

# lccc: the combining class of the first code point of cp's decomposition
def lccc(+cp: U32) -> U32:
  lccc.n(cp, syl(cp))

# is_start: a segment starts at a code point nothing before it can compose
# with. That is a starter -- and not a conjoining V or T jamo. The jamo
# exception is the whole reason this is not `lccc(cp) == 0`: V and T have
# combining class zero and still compose leftward, so a split in front of one
# would lose the syllable. Every other composition in coverage has a second
# element with a nonzero combining class, which is checked, not assumed.
def is_start(+cp: U32) -> Bool:
  Bool.and(Bool.not(Bool.or(Bool.and(U32.is_ge(cp, 4449), U32.is_lt(cp, 4470)),
    Bool.and(U32.is_gt(cp, 4519), U32.is_lt(cp, 4547)))), U32.is_zero(lccc(cp)))

def fold.d(+cp: U32, +k: U32, use: Bool) -> U32:
  match use:
    case True{}:
      U32.sub(U32.add(cp, U32.mod(k, 16384)), 1024)
    case False{}:
      cp

# ftab() stores a run as one delta plus a parity: 0 every code point in the
# run, 1 only the even ones, 2 only the odd ones. Latin is full of alternating
# upper/lower pairs, and a parity turns each of those runs into one row.
def fold.p(+cp: U32, +k: U32) -> U32:
  fold.d(cp, k, Bool.or(U32.is_zero(U32.div(k, 16384)),
    U32.is_eq(U32.div(k, 16384), U32.add(U32.mod(cp, 2), 1))))

def fold.z(+cp: U32, +k: U32, none: Bool) -> U32:
  match none:
    case True{}:
      cp
    case False{}:
      fold.p(cp, k)

def fold.j(+cp: U32, +k: U32) -> U32:
  fold.z(cp, k, U32.is_zero(k))

# fold: simple case folding, one code point to one. The ten code points in
# coverage whose full fold is longer than one -- U+00DF and its friends -- are
# left alone; see the ceiling in docs/omen/lanes/power-15.md.
def fold(+cp: U32) -> U32:
  fold.j(cp, look(ftab(), cp))

def comp.p(+a: U32, +b: U32, ok: Bool) -> U32:
  match ok:
    case True{}:
      look(ptab(), U32.add(U32.mul(a, 128), U32.sub(b, 768)))
    case False{}:
      0

def comp.t(+a: U32, +b: U32, ok: Bool) -> U32:
  match ok:
    case True{}:
      U32.add(a, U32.sub(b, 4519))
    case False{}:
      comp.p(a, b, Bool.and(U32.is_lt(a, 65536),
        Bool.and(U32.is_ge(b, 768), U32.is_le(b, 846))))

def comp.v(+a: U32, +b: U32, ok: Bool) -> U32:
  match ok:
    case True{}:
      U32.add(44032, U32.mul(U32.add(U32.mul(U32.sub(a, 4352), 21),
        U32.sub(b, 4449)), 28))
    case False{}:
      comp.t(a, b, Bool.and(Bool.and(syl(a),
        U32.is_zero(U32.mod(U32.sub(a, 44032), 28))),
        Bool.and(U32.is_gt(b, 4519), U32.is_lt(b, 4547))))

# comp: the code point a starter and the code point after it compose to, or 0.
# The two Hangul rules come first because a jamo would otherwise fall into a
# table that has no row for it. ptab() keys on a * 128 + (b - 0x300), which is
# exact because every second element in coverage is a mark in U+0300..U+0342.
def comp(+a: U32, +b: U32) -> U32:
  comp.v(a, b, Bool.and(Bool.and(U32.is_ge(a, 4352), U32.is_lt(a, 4371)),
    Bool.and(U32.is_ge(b, 4449), U32.is_lt(b, 4470))))

type Snk is Type:
  SnkE{v: Vec.Vec}
  SnkG{j: U32, v: Vec.Vec}

def snk.if(v: Vec.Vec, +j: U32, sw: Bool) -> Snk:
  match sw:
    case True{}:
      SnkG{U32.sub(j, 1), Vec.swap(v, U32.sub(j, 1), j)}
    case False{}:
      SnkE{v}

# the swap condition of UAX #15 D108, and the `> 0` half is not decoration: a
# starter never moves, so a class of zero stops the sink dead
def snk.cmp(v: Vec.Vec, +j: U32, +a: U32, +b: U32) -> Snk:
  snk.if(v, j, Bool.and(U32.is_gt(ccc(a), ccc(b)), U32.is_gt(ccc(b), 0)))

def snk.b(+j: U32, +a: U32, r: Vec.Vec & U32) -> Snk:
  (v, b) = r
  snk.cmp(v, j, a, b)

def snk.a(+j: U32, r: Vec.Vec & U32) -> Snk:
  (v, a) = r
  snk.b(j, a, Vec.at(v, j))

def snk.at(v: Vec.Vec, +j: U32) -> Snk:
  snk.a(j, Vec.at(v, U32.sub(j, 1)))

def snk.top(v: Vec.Vec, +j: U32, top: Bool) -> Snk:
  match top:
    case True{}:
      SnkE{v}
    case False{}:
      snk.at(v, j)

def snk.start(v: Vec.Vec, +j: U32) -> Snk:
  snk.top(v, j, U32.is_zero(j))

def snk.go(fuel: Nat, s: Snk) -> Vec.Vec:
  match fuel:
    case 0n:
      match s:
        case SnkE{v}:
          v
        case SnkG{j, v}:
          v
    case 1n++p:
      match s:
        case SnkE{v}:
          v
        case SnkG{j, v}:
          snk.go(p, snk.start(v, j))

def srt(fuel: Nat, v: Vec.Vec, +k: U32) -> Vec.Vec:
  match fuel:
    case 0n:
      v
    case 1n++p:
      srt(p, snk.go(U32.to_nat(k), snk.start(v, k)), U32.inc(k))

def order.if(v: Vec.Vec, +m: U32, tiny: Bool) -> Vec.Vec:
  match tiny:
    case True{}:
      v
    case False{}:
      srt(U32.to_nat(U32.sub(m, 1)), v, 1)

# order: canonical ordering. A stable insertion sort by combining class, which
# is the whole of it -- and it is quadratic in the length of one combining
# sequence, which real text keeps under five.
def order(v: Vec.Vec, +m: U32) -> Vec.Vec:
  order.if(v, m, U32.is_lt(m, 2))

type Cm is Type:
  Cm{sp: U32, sc: U32, w: U32, last: U32, d: U32, v: Vec.Vec}

def cm.take(c: Cm) -> Vec.Vec & U32:
  match c:
    case Cm{sp, sc, w, last, d, v}:
      (v, w)

def cm.set(+sp: U32, +sc: U32, +w: U32, +last: U32, +d: U32, v: Vec.Vec) -> Cm:
  Cm{sp, sc, w, last, U32.inc(d), v}

def cm.join(+sp: U32, +w: U32, +last: U32, +d: U32, +co: U32, v: Vec.Vec) -> Cm:
  cm.set(sp, co, w, last, d, Vec.put(v, sp, co))

def cm.keep(+sp: U32, +sc: U32, +w: U32, +cc: U32, +d: U32, +ch: U32,
  v: Vec.Vec, st: Bool) -> Cm:
  match st:
    case True{}:
      cm.set(w, ch, U32.inc(w), 0, d, Vec.put(v, w, ch))
    case False{}:
      cm.set(sp, sc, U32.inc(w), cc, d, Vec.put(v, w, ch))

def cm.pick(+sp: U32, +sc: U32, +w: U32, +last: U32, +d: U32, +ch: U32,
  +cc: U32, +co: U32, v: Vec.Vec, ok: Bool) -> Cm:
  match ok:
    case True{}:
      cm.join(sp, w, last, d, co, v)
    case False{}:
      cm.keep(sp, sc, w, cc, d, ch, v, U32.is_zero(cc))

# the blocked rule of D115: the starter takes the mark only if nothing already
# kept between them has an equal or higher class. `last` is that meter, and 256
# is its "the starter is itself a mark, nothing may join it" value.
def cm.at(+sp: U32, +sc: U32, +w: U32, +last: U32, +d: U32, v: Vec.Vec,
  +ch: U32, +cc: U32, +co: U32) -> Cm:
  cm.pick(sp, sc, w, last, d, ch, cc, co, v,
    Bool.and(U32.is_gt(co, 0), Bool.or(U32.is_lt(last, cc), U32.is_zero(last))))

def cm.ch(+sp: U32, +sc: U32, +w: U32, +last: U32, +d: U32, v: Vec.Vec,
  +ch: U32) -> Cm:
  cm.at(sp, sc, w, last, d, v, ch, ccc(ch), comp(sc, ch))

def cm.rd(+sp: U32, +sc: U32, +w: U32, +last: U32, +d: U32,
  r: Vec.Vec & U32) -> Cm:
  (v, ch) = r
  cm.ch(sp, sc, w, last, d, v, ch)

def cm.step(c: Cm) -> Cm:
  match c:
    case Cm{sp, sc, w, last, +d, v}:
      cm.rd(sp, sc, w, last, d, Vec.at(v, d))

def cm.go(fuel: Nat, c: Cm) -> Cm:
  match fuel:
    case 0n:
      c
    case 1n++p:
      cm.go(p, cm.step(c))

def cm.last.if(z: Bool) -> U32:
  match z:
    case True{}:
      0
    case False{}:
      256

def cm.last(+cc: U32) -> U32:
  cm.last.if(U32.is_zero(cc))

def cm.init2(+m: U32, v: Vec.Vec, +c0: U32) -> Vec.Vec & U32:
  cm.take(cm.go(U32.to_nat(U32.sub(m, 1)), Cm{0, c0, 1, cm.last(ccc(c0)), 1, v}))

def cm.init(+m: U32, r: Vec.Vec & U32) -> Vec.Vec & U32:
  (v, +c0) = r
  cm.init2(m, v, c0)

def compose.if(v: Vec.Vec, +m: U32, tiny: Bool) -> Vec.Vec & U32:
  match tiny:
    case True{}:
      (v, m)
    case False{}:
      cm.init(m, Vec.at(v, 0))

# compose: canonical composition in place, answering the new length. The buffer
# keeps its old length -- only the first w cells are the answer.
def compose(v: Vec.Vec, +m: U32) -> Vec.Vec & U32:
  compose.if(v, m, U32.is_lt(m, 2))

# -- the offset map ----------------------------------------------------------

# Norm: the normalized bytes, and the map. src and dst are the same list of
# segments in the two coordinate systems -- src[j] is where segment j starts in
# the original, dst[j] is where it starts in the normalized text -- each
# strictly increasing and each closed by the length of its own buffer, so
# segment j is [t[j], t[j+1]) in both and the last one is not a special case.
type Norm is Type:
  Norm{out: Bytes(), src: Vec.Vec, dst: Vec.Vec}

# Span: a citation that survives normalization. doc and rev are the caller's
# own identifiers -- a range without the revision it was taken against is a
# range that will one day point at the wrong bytes.
type Span is Data:
  Span{doc: U32, rev: U32, start: U32, end: U32}

type Form is Data:
  Nfd{}
  Nfc{}
  Fold{}

def fkey(f: Form) -> U32:
  match f:
    case Nfd{}:
      0
    case Nfc{}:
      1
    case Fold{}:
      2

type Acc is Type:
  Acc{out: Bytes(), src: Vec.Vec, dst: Vec.Vec, buf: Vec.Vec}

type Enc is Type:
  Enc{k: U32, out: Bytes(), v: Vec.Vec}

def enc.put(+k: U32, r: Vec.Vec & U32, out: Bytes()) -> Enc:
  (v, c) = r
  Enc{U32.inc(k), emit(out, c), v}

def enc.step(e: Enc) -> Enc:
  match e:
    case Enc{+k, out, v}:
      enc.put(k, Vec.at(v, k), out)

def enc.go(fuel: Nat, e: Enc) -> Enc:
  match fuel:
    case 0n:
      e
    case 1n++p:
      enc.go(p, enc.step(e))

def enc.take(e: Enc) -> Bytes() & Vec.Vec:
  match e:
    case Enc{k, out, v}:
      (out, v)

def fl.done(src: Vec.Vec, dst: Vec.Vec, r: Bytes() & Vec.Vec) -> Acc:
  (out, v) = r
  Acc{out, src, dst, Vec.truncate(v, 0)}

def fl.enc(src: Vec.Vec, dst: Vec.Vec, out: Bytes(), v: Vec.Vec, +w: U32) -> Acc:
  fl.done(src, dst, enc.take(enc.go(U32.to_nat(w), Enc{0, out, v})))

# the map row is written here and nowhere else: one segment out, one pair of
# starts in
def fl.map(src: Vec.Vec, dst: Vec.Vec, +seg: U32, v: Vec.Vec, +w: U32,
  r: Bytes() & U32) -> Acc:
  (out, n) = r
  fl.enc(Vec.push(src, seg), Vec.push(dst, n), out, v, w)

def fl.w(out: Bytes(), src: Vec.Vec, dst: Vec.Vec, +seg: U32,
  r: Vec.Vec & U32) -> Acc:
  (v, w) = r
  fl.map(src, dst, seg, v, w, By.len(out))

def fl.form(out: Bytes(), src: Vec.Vec, dst: Vec.Vec, +seg: U32, v: Vec.Vec,
  +m: U32, nfd: Bool) -> Acc:
  match nfd:
    case True{}:
      fl.w(out, src, dst, seg, (v, m))
    case False{}:
      fl.w(out, src, dst, seg, compose(v, m))

def fl.go(out: Bytes(), src: Vec.Vec, dst: Vec.Vec, +seg: U32, buf: Vec.Vec,
  +m: U32, +fm: U32) -> Acc:
  fl.form(out, src, dst, seg, order(buf, m), m, U32.is_zero(fm))

def flush(out: Bytes(), src: Vec.Vec, dst: Vec.Vec, buf: Vec.Vec, +seg: U32,
  +m: U32, +fm: U32, empty: Bool) -> Acc:
  match empty:
    case True{}:
      Acc{out, src, dst, buf}
    case False{}:
      fl.go(out, src, dst, seg, buf, m, fm)

type Cur is Type:
  CEnd{seg: U32, out: Bytes(), src: Vec.Vec, dst: Vec.Vec, inp: Bytes(),
    buf: Vec.Vec}
  CGo{i: U32, seg: U32, out: Bytes(), src: Vec.Vec, dst: Vec.Vec,
    inp: Bytes(), buf: Vec.Vec}

def nm.case.if(+cp: U32, f: Bool) -> U32:
  match f:
    case True{}:
      fold(cp)
    case False{}:
      cp

def nm.case(+cp: U32, +fm: U32) -> U32:
  nm.case.if(cp, U32.is_eq(fm, 2))

def nm.end(+seg: U32, out: Bytes(), src: Vec.Vec, dst: Vec.Vec, inp: Bytes(),
  buf: Vec.Vec, +j: U32, done: Bool) -> Cur:
  match done:
    case True{}:
      CEnd{seg, out, src, dst, inp, buf}
    case False{}:
      CGo{j, seg, out, src, dst, inp, buf}

def nm.acc(+seg: U32, +n: U32, inp: Bytes(), +j: U32, +c2: U32, a: Acc) -> Cur:
  match a:
    case Acc{out, src, dst, buf}:
      nm.end(seg, out, src, dst, inp, dcp(buf, c2), j, U32.is_ge(j, n))

# the one decision in the loop: a code point that can open a segment closes the
# one in hand, and the segment it closes is the one whose original start was
# remembered in seg
def nm.cut(+i: U32, +seg: U32, +n: U32, out: Bytes(), src: Vec.Vec,
  dst: Vec.Vec, buf: Vec.Vec, +m: U32, inp: Bytes(), +j: U32, +c2: U32,
  +fm: U32, cut: Bool) -> Cur:
  match cut:
    case True{}:
      nm.acc(i, n, inp, j, c2, flush(out, src, dst, buf, seg, m, fm, False{}))
    case False{}:
      nm.acc(seg, n, inp, j, c2, Acc{out, src, dst, buf})

def nm.cp(+i: U32, +seg: U32, +n: U32, +fm: U32, out: Bytes(), src: Vec.Vec,
  dst: Vec.Vec, buf: Vec.Vec, +m: U32, inp: Bytes(), +j: U32, +c2: U32) -> Cur:
  nm.cut(i, seg, n, out, src, dst, buf, m, inp, j, c2, fm,
    Bool.and(is_start(c2), U32.is_gt(m, 0)))

def nm.cw(+i: U32, +seg: U32, +n: U32, +fm: U32, out: Bytes(), src: Vec.Vec,
  dst: Vec.Vec, buf: Vec.Vec, +m: U32, inp: Bytes(), cw: U32 & U32) -> Cur:
  (cp, w) = cw
  nm.cp(i, seg, n, fm, out, src, dst, buf, m, inp, U32.add(i, w),
    nm.case(cp, fm))

def nm.dec(+i: U32, +seg: U32, +n: U32, +fm: U32, out: Bytes(), src: Vec.Vec,
  dst: Vec.Vec, buf: Vec.Vec, +m: U32, r: Bytes() & (U32 & U32)) -> Cur:
  (inp, cw) = r
  nm.cw(i, seg, n, fm, out, src, dst, buf, m, inp, cw)

def nm.len(+i: U32, +seg: U32, +n: U32, +fm: U32, out: Bytes(), src: Vec.Vec,
  dst: Vec.Vec, inp: Bytes(), r: Vec.Vec & U32) -> Cur:
  (buf, m) = r
  nm.dec(i, seg, n, fm, out, src, dst, buf, m, decode(inp, i))

def nm.step(c: Cur, +n: U32, +fm: U32) -> Cur:
  match c:
    case CEnd{seg, out, src, dst, inp, buf}:
      CEnd{seg, out, src, dst, inp, buf}
    case CGo{+i, seg, out, src, dst, inp, buf}:
      nm.len(i, seg, n, fm, out, src, dst, inp, Vec.len(buf))

def nm.go(fuel: Nat, c: Cur, +n: U32, +fm: U32) -> Cur:
  match fuel:
    case 0n:
      c
    case 1n++p:
      nm.go(p, nm.step(c, n, fm), n, fm)

def nm.sent(+n: U32, src: Vec.Vec, dst: Vec.Vec, r: Bytes() & U32) -> Norm:
  (out, on) = r
  Norm{out, Vec.push(src, n), Vec.push(dst, on)}

def nm.fin(+n: U32, a: Acc) -> Norm:
  match a:
    case Acc{out, src, dst, buf}:
      nm.sent(n, src, dst, By.len(out))

def nm.last(+n: U32, +fm: U32, +seg: U32, out: Bytes(), src: Vec.Vec,
  dst: Vec.Vec, r: Vec.Vec & U32) -> Norm:
  (buf, +m) = r
  nm.fin(n, flush(out, src, dst, buf, seg, m, fm, U32.is_zero(m)))

def nm.close(c: Cur, +n: U32, +fm: U32) -> Norm:
  match c:
    case CEnd{seg, out, src, dst, inp, buf}:
      nm.last(n, fm, seg, out, src, dst, Vec.len(buf))
    case CGo{i, seg, out, src, dst, inp, buf}:
      nm.last(n, fm, seg, out, src, dst, Vec.len(buf))

def nm.st(b: Bytes(), +n: U32, empty: Bool) -> Cur:
  match empty:
    case True{}:
      CEnd{0, By.new(), Vec.new(0), Vec.new(0), b, Vec.new(0)}
    case False{}:
      CGo{0, 0, By.new(), Vec.new(0), Vec.new(0), b, Vec.new(0)}

def nm.start(b: Bytes(), +n: U32) -> Cur:
  nm.st(b, n, U32.is_zero(n))

def nm.init(b: Bytes(), +n: U32, +fm: U32) -> Norm:
  nm.close(nm.go(U32.to_nat(U32.inc(n)), nm.start(b, n), n, fm), n, fm)

def norm.n(f: Form, r: Bytes() & U32) -> Norm:
  (b, n) = r
  nm.init(b, n, fkey(f))

# norm: the normalized bytes and the map back, in one pass. It takes the
# original and does not hand it back, because the map is what a caller keeps.
# Fold is simple case folding followed by NFC, which is what a search index
# wants: one form, folded, composed.
def norm(b: Bytes(), f: Form) -> Norm:
  norm.n(f, By.len(b))

type Bs is Type:
  Bs{lo: U32, hi: U32, v: Vec.Vec}

def bs.set(v: Vec.Vec, +lo: U32, +hi: U32, +m: U32, le: Bool) -> Bs:
  match le:
    case True{}:
      Bs{m, hi, v}
    case False{}:
      Bs{lo, U32.sub(m, 1), v}

def bs.at(+lo: U32, +hi: U32, +m: U32, +x: U32, r: Vec.Vec & U32) -> Bs:
  (v, y) = r
  bs.set(v, lo, hi, m, U32.is_le(y, x))

def bs.m2(v: Vec.Vec, +lo: U32, +hi: U32, +x: U32, +m: U32) -> Bs:
  bs.at(lo, hi, m, x, Vec.at(v, m))

def bs.mid(v: Vec.Vec, +lo: U32, +hi: U32, +x: U32) -> Bs:
  bs.m2(v, lo, hi, x, U32.shrn(U32.add(U32.add(lo, hi), 1), 1n))

# ponytail: 32 rounds, no early exit -- once lo meets hi the round is a read
# and two assignments that change nothing, and a Done arm would cost more than
# it saves. A document with few segments pays five or six wasted compares; the
# upgrade is the Done/More state loop if that ever shows up in a profile.
def bs.go(fuel: Nat, s: Bs, +x: U32) -> Vec.Vec & U32:
  match fuel:
    case 0n:
      match s:
        case Bs{lo, hi, v}:
          (v, lo)
    case 1n++p:
      match s:
        case Bs{lo, hi, v}:
          bs.go(p, bs.mid(v, lo, hi, x), x)

def segof(v: Vec.Vec, +x: U32, +hi: U32) -> Vec.Vec & U32:
  bs.go(32n, Bs{0, hi, v}, x)

def rng.b(+a: U32, r: Vec.Vec & U32) -> Vec.Vec & (U32 & U32):
  (v, b) = r
  (v, (a, b))

def rng.a(+j: U32, r: Vec.Vec & U32) -> Vec.Vec & (U32 & U32):
  (v, a) = r
  rng.b(a, Vec.at(v, U32.inc(j)))

def rng(v: Vec.Vec, +j: U32) -> Vec.Vec & (U32 & U32):
  rng.a(j, Vec.at(v, j))

def hi.if(+ln: U32, tiny: Bool) -> U32:
  match tiny:
    case True{}:
      0
    case False{}:
      U32.sub(ln, 2)

# the last real segment index: a table of s segments is s + 1 long
def hi(+ln: U32) -> U32:
  hi.if(ln, U32.is_lt(ln, 2))

def back.s(out: Bytes(), dst: Vec.Vec, r: Vec.Vec & (U32 & U32)) ->
  Norm & (U32 & U32):
  (src, ab) = r
  (Norm{out, src, dst}, ab)

def back.j(out: Bytes(), src: Vec.Vec, r: Vec.Vec & U32) -> Norm & (U32 & U32):
  (dst, j) = r
  back.s(out, dst, rng(src, j))

def back.n(out: Bytes(), src: Vec.Vec, dst: Vec.Vec, +o: U32, +ln: U32) ->
  Norm & (U32 & U32):
  back.j(out, src, segof(dst, o, hi(ln)))

def back.len(out: Bytes(), src: Vec.Vec, +o: U32, r: Vec.Vec & U32) ->
  Norm & (U32 & U32):
  (dst, ln) = r
  back.n(out, src, dst, o, ln)

# back: the byte range of the original that produced the normalized offset o.
# The answer is a whole segment and not a code point, because inside a segment
# the normalizer is free to reorder and to compose -- a finer map would be a
# map that lies. o must be below the normalized length; an empty document has
# no segments and back has nothing to say about it.
def back(m: Norm, +o: U32) -> Norm & (U32 & U32):
  match m:
    case Norm{out, src, dst}:
      back.len(out, src, o, Vec.len(dst))

def fwd.s(out: Bytes(), src: Vec.Vec, r: Vec.Vec & (U32 & U32)) ->
  Norm & (U32 & U32):
  (dst, ab) = r
  (Norm{out, src, dst}, ab)

def fwd.j(out: Bytes(), dst: Vec.Vec, r: Vec.Vec & U32) -> Norm & (U32 & U32):
  (src, j) = r
  fwd.s(out, src, rng(dst, j))

def fwd.n(out: Bytes(), src: Vec.Vec, dst: Vec.Vec, +o: U32, +ln: U32) ->
  Norm & (U32 & U32):
  fwd.j(out, dst, segof(src, o, hi(ln)))

def fwd.len(out: Bytes(), dst: Vec.Vec, +o: U32, r: Vec.Vec & U32) ->
  Norm & (U32 & U32):
  (src, ln) = r
  fwd.n(out, src, dst, o, ln)

# fwd: the normalized byte range the original offset o landed in -- the same
# map read the other way, for a caller holding a citation in the original that
# wants to find it in the text it actually searched.
def fwd(m: Norm, +o: U32) -> Norm & (U32 & U32):
  match m:
    case Norm{out, src, dst}:
      fwd.len(out, dst, o, Vec.len(src))

def span(+doc: U32, +rev: U32, ab: U32 & U32) -> Span:
  (s, e) = ab
  Span{doc, rev, s, e}

def span.show(sp: Span) -> String:
  match sp:
    case Span{doc, rev, s, e}:
      String.append(String.append(String.append(String.append(
        String.append(String.append(U32.show(doc), ":"), U32.show(rev)), ":"),
        U32.show(s)), "-"), U32.show(e))

type Cp2 is Type:
  Cp2{i: U32, a: Bytes(), b: Bytes()}

def sl.put(+i: U32, b: Bytes(), r: Bytes() & U32) -> Cp2:
  (a, x) = r
  Cp2{U32.inc(i), a, By.push(b, x)}

def sl.step(c: Cp2) -> Cp2:
  match c:
    case Cp2{+i, a, b}:
      sl.put(i, b, By.at(a, i))

def sl.go(fuel: Nat, c: Cp2) -> Cp2:
  match fuel:
    case 0n:
      c
    case 1n++p:
      sl.go(p, sl.step(c))

def sl.take(c: Cp2) -> Bytes() & Bytes():
  match c:
    case Cp2{i, a, b}:
      (a, b)

# slice: the bytes of [s, e) as their own buffer; the original is handed back.
# This is the other half of a citation -- back gives the range, slice gives the
# bytes, and re-normalizing those bytes is the law the fixture pins.
def slice(a: Bytes(), +s: U32, +e: U32) -> Bytes() & Bytes():
  sl.take(sl.go(U32.to_nat(U32.sub(e, s)), Cp2{s, a, By.new()}))

def nlen.r(src: Vec.Vec, dst: Vec.Vec, r: Bytes() & U32) -> Norm & U32:
  (out, n) = r
  (Norm{out, src, dst}, n)

def nlen(m: Norm) -> Norm & U32:
  match m:
    case Norm{out, src, dst}:
      nlen.r(src, dst, By.len(out))

def nsegs.r(out: Bytes(), dst: Vec.Vec, r: Vec.Vec & U32) -> Norm & U32:
  (src, ln) = r
  (Norm{out, src, dst}, U32.sub(ln, 1))

def nsegs(m: Norm) -> Norm & U32:
  match m:
    case Norm{out, src, dst}:
      nsegs.r(out, dst, Vec.len(src))

def nslice.r(src: Vec.Vec, dst: Vec.Vec, r: Bytes() & Bytes()) ->
  Norm & Bytes():
  (out, x) = r
  (Norm{out, src, dst}, x)

def nslice(m: Norm, +s: U32, +e: U32) -> Norm & Bytes():
  match m:
    case Norm{out, src, dst}:
      nslice.r(src, dst, slice(out, s, e))

def ncps.r(src: Vec.Vec, dst: Vec.Vec, r: Bytes() & String) -> Norm & String:
  (out, s) = r
  (Norm{out, src, dst}, s)

# ncps: the code points of the normalized text
def ncps(m: Norm) -> Norm & String:
  match m:
    case Norm{out, src, dst}:
      ncps.r(src, dst, cps(out))
